<Window x:Class="Noty4Me.UI.NotesWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Noty4Me" Height="540" Width="820"
        WindowStartupLocation="CenterScreen"
        MinHeight="320" MinWidth="560"
        Background="{DynamicResource Brush.Base}"
        Foreground="{DynamicResource Brush.Text}"
        FontFamily="Segoe UI" FontSize="13"
        TextOptions.TextFormattingMode="Display">
    <Grid Margin="14">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="260"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Sidebar header -->
        <StackPanel Grid.Row="0" Grid.Column="0" Orientation="Horizontal" Margin="0,0,0,8">
            <TextBlock Text="Notes" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center"/>
            <Button x:Name="NewBtn" Content="+ New" Margin="14,0,0,0" Click="OnNew" Padding="10,4"/>
        </StackPanel>

        <!-- Note list -->
        <ListBox Grid.Row="1" Grid.Column="0" x:Name="NoteList"
                 DisplayMemberPath="DisplayTitle"
                 SelectionChanged="OnSelectionChanged"
                 Margin="0,0,14,0"/>

        <!-- Editor header -->
        <Grid Grid.Row="0" Grid.Column="1" Margin="0,0,0,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBox x:Name="TitleBox" Grid.Column="0"
                     FontSize="15" FontWeight="SemiBold"
                     TextChanged="OnTitleChanged"/>
            <Button Grid.Column="1" Content="Settings" Margin="8,0,0,0" Click="OnOpenSettings"/>
            <Button Grid.Column="2" Content="Delete" Margin="8,0,0,0" Click="OnDelete"
                    Background="{DynamicResource Brush.Red}"
                    Foreground="{DynamicResource Brush.Crust}"/>
        </Grid>

        <!-- Editor body -->
        <TextBox Grid.Row="1" Grid.Column="1" x:Name="BodyBox"
                 AcceptsReturn="True" TextWrapping="Wrap"
                 VerticalScrollBarVisibility="Auto"
                 TextChanged="OnBodyChanged"/>

        <!-- Status bar -->
        <TextBlock Grid.Row="2" Grid.ColumnSpan="2" x:Name="StatusText"
                   Margin="0,8,0,0"
                   Foreground="{DynamicResource Brush.Subtext0}"
                   FontSize="11"/>
    </Grid>
</Window>
